# ──────────────────────────────────────────────────────────────────────────────
# Frontend (Next.js) — copy to .env.local for local development.
# On Vercel set these in Project Settings → Environment Variables
# (Production AND Preview). They are read at BUILD time — redeploy after changes.
# A Vercel build fails fast if any of the three are missing.
# ──────────────────────────────────────────────────────────────────────────────

# [required] Base URL of the Express backend (no trailing slash, no /api).
# Server-side only: target of the /api/* and /uploads/* rewrites and SSR fetches.
BACKEND_URL=http://localhost:5000

# [required] Public backend URL used directly by the browser for:
#   • Socket.IO (WebSockets cannot pass through Vercel rewrites)
#   • listing photo uploads (multipart; bypasses the rewrite proxy's size limits)
# Usually identical to BACKEND_URL. Also added to the Content-Security-Policy.
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# [required on Vercel] Public URL of this site — canonical URLs, Open Graph, sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

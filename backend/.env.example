# ──────────────────────────────────────────────────────────────────────────────
# Backend (Express + Socket.IO) — copy to .env and fill in.
# Never commit real values. Variables marked [required] must be set.
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# [required] PostgreSQL. With Neon/Supabase use the DIRECT (non-pooled) URL and
# append ?sslmode=require.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rent_flatmate_finder

# ── Auth ─────────────────────────────────────────────────────────────────────
# [required] ≥ 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── Browser access ───────────────────────────────────────────────────────────
# Comma-separated origins allowed for CORS and Socket.IO (your frontend URLs).
CORS_ORIGIN=http://localhost:3000
# Public URL of the frontend — used for links in emails.
APP_URL=http://localhost:3000
# Number of reverse proxies in front of this API. Render alone = 1;
# Vercel rewrites → Render = 2 (so rate limits see the real client IP).
TRUST_PROXY=1
# Refresh-cookie SameSite. Keep "lax" when the frontend proxies /api (default setup).
COOKIE_SAMESITE=lax

# ── AI compatibility (optional — rule-based scoring is used when unset) ──────
# LLM_PROVIDER: openai | anthropic | none
LLM_PROVIDER=none
LLM_API_KEY=
# Defaults: gpt-4o-mini (openai) / claude-opus-5-5 (anthropic)
LLM_MODEL=
LLM_TIMEOUT_MS=45000
# Owner gets a "high-match" email at or above this score.
HIGH_SCORE_THRESHOLD=80

# ── Email (optional) ─────────────────────────────────────────────────────────
# EMAIL_PROVIDER: resend | nodemailer | none
EMAIL_PROVIDER=none
EMAIL_API_KEY=
# Must be a sender on a domain verified in Resend (onboarding@resend.dev works for testing).
EMAIL_FROM=Rent & Flatmate Finder <onboarding@resend.dev>
# SMTP (only for EMAIL_PROVIDER=nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Image storage ────────────────────────────────────────────────────────────
# Strongly recommended in production (most hosts have ephemeral disks).
# Without these, uploads are stored in ./uploads (development only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rent-flatmate-finder
# Only needed for local uploads when the API is reached directly (not via the frontend proxy).
PUBLIC_API_URL=

# ── Demo seed (npm run db:seed) ──────────────────────────────────────────────
SEED_PASSWORD=Password123!
# The seed wipes all data and refuses to run when NODE_ENV=production unless this is true.
ALLOW_DEMO_SEED=false

// ──────────────────────────────────────────────────────────────────────────────
// Prisma Schema — Rent & Flatmate Finder
//
// Entities, relations, indexes and cascade/restrict rules are documented inline.
// ──────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Neon/Supabase: use the *direct* (non-pooled) connection string — the API
  // is a long-lived server, and `prisma migrate deploy` needs session locks.
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  TENANT
  OWNER
  ADMIN
}

enum ListingStatus {
  ACTIVE
  FILLED
}

enum RoomType {
  SINGLE
  DOUBLE
  SHARED
  STUDIO
  APARTMENT
}

enum FurnishingStatus {
  FURNISHED
  SEMI_FURNISHED
  UNFURNISHED
}

enum InterestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ComputedVia {
  LLM
  FALLBACK
}

enum NotificationType {
  INTEREST_RECEIVED
  INTEREST_ACCEPTED
  INTEREST_DECLINED
  NEW_MESSAGE
  LISTING_FILLED
  COMPATIBILITY_COMPUTED
  LISTING_UPDATED
  NEW_MATCH
  SYSTEM
}

// ── Lifestyle enums (shared by tenant profiles and listing households) ──────

enum SleepSchedule {
  EARLY_BIRD
  NIGHT_OWL
  FLEXIBLE
}

enum WorkSchedule {
  OFFICE
  REMOTE
  HYBRID
  SHIFTS
  STUDENT
}

enum FoodPreference {
  VEGETARIAN
  NON_VEGETARIAN
  VEGAN
  EGGETARIAN
  NO_PREFERENCE
}

enum SmokingHabit {
  NON_SMOKER
  OCCASIONAL
  SMOKER
}

enum RoomSharingPreference {
  PRIVATE_ROOM
  SHARED_ROOM
  ENTIRE_PLACE
  NO_PREFERENCE
}

// Flatmate gender preference stated by the lister for shared accommodation.
// Used only as a search filter — never as an input to compatibility scoring.
enum GenderPreference {
  ANY
  MALE
  FEMALE
}

// ─── User ────────────────────────────────────────────────────────────────────
// Central auth entity. Role determines whether they see owner or tenant flows.

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  hashedPassword String    @map("hashed_password")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  phone          String?
  avatarUrl      String?   @map("avatar_url")
  role           UserRole  @default(TENANT)
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // ── Relations ──
  tenantProfile       TenantProfile?
  listings            Listing[] // only populated for OWNER role
  compatibilityScores CompatibilityScore[] // only populated for TENANT role
  interestRequests    InterestRequest[] // tenant's interest requests
  sentMessages        ChatMessage[]        @relation("SentMessages")
  notifications       Notification[]
  refreshTokens       RefreshToken[]
  savedListings       SavedListing[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

// ─── TenantProfile ───────────────────────────────────────────────────────────
// Housing preferences + lifestyle for the compatibility engine.

model TenantProfile {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")
  preferredLocation String   @map("preferred_location")
  budgetMin         Int      @map("budget_min")
  budgetMax         Int      @map("budget_max")
  moveInDate        DateTime @map("move_in_date")
  occupation        String?
  lifestyle         String? // free text, e.g. "early-riser, non-smoker"
  bio               String? // free-text self-description

  // Structured lifestyle signals. All optional — unanswered factors are
  // excluded from scoring rather than guessed.
  cleanliness    Int? // 1 (relaxed) – 5 (very tidy)
  sleepSchedule  SleepSchedule?         @map("sleep_schedule")
  workSchedule   WorkSchedule?          @map("work_schedule")
  foodPreference FoodPreference?        @map("food_preference")
  smoking        SmokingHabit?
  hasPets        Boolean?               @map("has_pets")
  roomSharing    RoomSharingPreference? @map("room_sharing")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // CASCADE: if the user is deleted, their tenant profile goes with them.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([preferredLocation])
  @@index([budgetMin, budgetMax])
  @@map("tenant_profiles")
}

// ─── Listing ─────────────────────────────────────────────────────────────────

model Listing {
  id               String           @id @default(cuid())
  ownerId          String           @map("owner_id")
  title            String
  description      String
  location         String // city
  locality         String? // neighbourhood / area within the city
  address          String?
  rent             Int // monthly rent in currency units
  deposit          Int? // security deposit
  availableFrom    DateTime         @map("available_from")
  roomType         RoomType         @map("room_type")
  furnishingStatus FurnishingStatus @map("furnishing_status")
  amenities        String[] // e.g. ["wifi", "parking", "laundry", "gym"]
  rules            String[] // e.g. ["no-smoking", "no-pets"]
  maxOccupants     Int              @default(1) @map("max_occupants")
  status           ListingStatus    @default(ACTIVE)
  genderPreference GenderPreference @default(ANY) @map("gender_preference")

  // Household signals (null = not specified by the owner)
  petsAllowed            Boolean?        @map("pets_allowed")
  smokingAllowed         Boolean?        @map("smoking_allowed")
  foodPolicy             FoodPreference? @map("food_policy")
  householdSleepSchedule SleepSchedule?  @map("household_sleep_schedule")
  householdCleanliness   Int?            @map("household_cleanliness")

  viewCount Int      @default(0) @map("view_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // RESTRICT: cannot delete an owner who still has listings.
  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  photos              ListingPhoto[]
  compatibilityScores CompatibilityScore[]
  interestRequests    InterestRequest[]
  savedBy             SavedListing[]

  @@index([status, createdAt])
  @@index([status, location])
  @@index([location])
  @@index([rent])
  @@index([roomType])
  @@index([ownerId])
  @@index([availableFrom])
  @@map("listings")
}

// ─── ListingPhoto ────────────────────────────────────────────────────────────

model ListingPhoto {
  id        String   @id @default(cuid())
  listingId String   @map("listing_id")
  url       String
  publicId  String?  @map("public_id") // storage-provider id (Cloudinary) for cleanup
  altText   String?  @map("alt_text")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  // CASCADE: photos are deleted when the listing is deleted.
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_photos")
}

// ─── CompatibilityScore ──────────────────────────────────────────────────────
// Cached compatibility score between a tenant and a listing. `inputHash`
// fingerprints every scored input, so any profile/listing change invalidates it.

model CompatibilityScore {
  id          String      @id @default(cuid())
  tenantId    String      @map("tenant_id")
  listingId   String      @map("listing_id")
  score       Int // 0–100 compatibility percentage
  explanation String // LLM-generated or rule-based reasoning
  factors     Json? // { breakdown[], positives[], conflicts[], recommendations[] }
  inputHash   String?     @map("input_hash")
  computedVia ComputedVia @map("computed_via")
  computedAt  DateTime    @default(now()) @map("computed_at")

  tenant  User    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([tenantId, listingId])
  @@index([tenantId])
  @@index([listingId])
  @@index([score])
  @@map("compatibility_scores")
}

// ─── InterestRequest ─────────────────────────────────────────────────────────
// The "handshake" between tenant and owner. Accepting one opens a Conversation.

model InterestRequest {
  id         String         @id @default(cuid())
  tenantId   String         @map("tenant_id")
  listingId  String         @map("listing_id")
  status     InterestStatus @default(PENDING)
  message    String? // optional intro message from tenant
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  resolvedAt DateTime?      @map("resolved_at")

  tenant       User          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listing      Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  conversation Conversation?

  @@unique([tenantId, listingId]) // one interest per tenant per listing
  @@index([tenantId])
  @@index([listingId])
  @@index([status])
  @@map("interest_requests")
}

// ─── Conversation ────────────────────────────────────────────────────────────

model Conversation {
  id                String   @id @default(cuid())
  interestRequestId String   @unique @map("interest_request_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  interestRequest InterestRequest @relation(fields: [interestRequestId], references: [id], onDelete: Cascade)
  messages        ChatMessage[]

  @@map("conversations")
}

// ─── ChatMessage ─────────────────────────────────────────────────────────────

model ChatMessage {
  id             String    @id @default(cuid())
  conversationId String    @map("conversation_id")
  senderId       String    @map("sender_id")
  content        String
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("chat_messages")
}

// ─── Notification ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  metadata  Json? // { listingId, interestRequestId, conversationId, ... }
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([type])
  @@map("notifications")
}

// ─── RefreshToken ────────────────────────────────────────────────────────────
// Opaque refresh tokens stored only as SHA-256 hashes. Each login starts a
// token family; every refresh rotates the token. Presenting an already-rotated
// token is treated as theft and revokes the whole family.

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  familyId   String    @map("family_id")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedAt DateTime? @map("replaced_at")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ─── SavedListing ────────────────────────────────────────────────────────────
// Tenant wishlist.

model SavedListing {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  listingId String   @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId, createdAt])
  @@map("saved_listings")
}
